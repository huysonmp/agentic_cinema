# Google Cloud — identifiers only, never place real secrets in this committed file.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=your-supported-location
GOOGLE_GENAI_USE_VERTEXAI=true

# Application
APP_ENV=development
LOG_LEVEL=INFO
ARTIFACT_BUCKET=your-private-artifact-bucket
RAG_CORPUS_ID=

# Model aliases are configuration. Verify availability, lifecycle, region and pricing.
GEMINI_REASONING_MODEL=
GEMINI_FAST_MODEL=
IMAGE_MODEL=
VIDEO_MODEL=
TTS_MODEL=

# Store partner credentials in Secret Manager; use only secret resource names here.
PARTNER_API_SECRET_RESOURCE=

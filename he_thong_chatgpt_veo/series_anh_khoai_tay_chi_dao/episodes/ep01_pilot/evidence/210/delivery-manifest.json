  "captions": [
    {
      "line_id": "N01",
      "speaker": "Đào",
      "start": 0,
      "end": 2.1,
      "text": "Anh nhìn mãi.\nKhông hợp thì để em."
    },
    {
      "line_id": "N02",
      "speaker": "Khoai",
      "start": 2.15,
      "end": 3.05,
      "text": "Khoan."
    },
    {
      "line_id": "N02",
      "speaker": "Khoai",
      "start": 3.41,
      "end": 5.24,
      "text": "Mùi này làm anh nhớ\nđến bếp nhà anh."
    },
    {
      "line_id": "N02",
      "speaker": "Khoai",
      "start": 6.07,
      "end": 8.54,
      "text": "Hồi bé, mẹ rang gạo,"
    },
    {
      "line_id": "N02",
      "speaker": "Khoai",
      "start": 8.75,
      "end": 12.1,
      "text": "anh đứng chờ."
    },
    {
      "line_id": "N03",
      "speaker": "Đào",
      "start": 12.155,
      "end": 13.025,
      "text": "Anh chờ ăn à?"
    },
    {
      "line_id": "N04",
      "speaker": "Khoai",
      "start": 13.025,
      "end": 14.1,
      "text": "Chờ mẹ quay lưng."
    },
    {
      "line_id": "N05",
      "speaker": "Đào",
      "start": 22.283,
      "end": 24.003,
      "text": "Chờ em quay lưng nữa à?"
    },
    {
      "line_id": "N06",
      "speaker": "Khoai",
      "start": 24.763,
      "end": 26.143,
      "text": "Anh gắp cho em mà."
    },
    {
      "line_id": "N07",
      "speaker": "Đào",
      "start": 26.643,
      "end": 28.503,
      "text": "Thế em quay lại đúng lúc rồi."
    }
  ],
  "release_overlays": [
    {
      "id": "F01",
      "start": 0,
      "end": 4.167,
      "text": "Nem Bùi — gắn với\nBùi Xá, Bắc Ninh."
    },
    {
      "id": "F02",
      "start": 5.2,
      "end": 9.7,
      "text": "Thính gạo rang góp một phần\nvào mùi vị của Nem Bùi."
    },
    {
      "id": "AI",
      "start": 0,
      "end": 30,
      "text": "Video được tạo bằng AI."
    }
  ],
